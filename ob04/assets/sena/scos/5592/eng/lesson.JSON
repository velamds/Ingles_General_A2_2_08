{"_data": [{"contents": [{"content": "Sally Goes on a Safari", "type": "lesson_name"}, {"content": "The Most Important Lesson ", "type": "unit_name"}, {"content": 4, "type": "position"}, {"content": "scholar > Nature Around Us > Safari", "type": "origin"}, {"content": 8, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": " Describe characteristics of different people and their jobs.", "type": "primary"}, {"content": " Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_1"}, {"content": " Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_2"}, {"content": " Identifies the expressions and vocabulary necessary for the description of places of work and jobs in common written and spoken situations. ", "type": "secondary_3"}, {"content": " Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_4"}, {"content": " Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_5"}, {"content": " Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_6"}, {"content": " Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_7"}, {"content": " Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn5le08ob04re1img01.jpg", "type": "background_image"}, {"contents": [{"content": " Consonant Sounds: <span class=\"italic\">Th</span>, <span class=\"italic\">D</span> and <span class=\"italic\">Z</span>", "type": "heading"}, {"content": "Certain sounds can be difficult to say and use together.", "type": "describer"}, {"content": "The sounds that <span class =\"strong\">th</span>, <span class =\"strong\">d</span> and <span class =\"strong\">z</span> make are similar. However, each sound is created differently.", "type": "text"}, {"content": "To make the <span class =\"strong\">th</span> sound:<br />  Bite your tongue, and then blow, letting the air come in the upper part of your tongue.", "type": "text"}, {"content": "To make the <span class =\"strong\">d</span> sound:<br />  The sound happens when your tongue taps the roof of your mouth to stop the air, then quickly releases.", "type": "text"}, {"content": "To make the <span class =\"strong\">z</span> sound:<br />  Your teeth come together to make the Z, and your tongue is pushed against your teeth. ", "type": "text"}, {"content": "Say these words together: <span class=\"italic\">think, drink, zinc or through, drew, zoo", "type": "text"}], "type": "learning_points"}, {"contents": [{"content": "safari ", "type": "name"}, {"content": "a journey to see or hunt animals  ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Sally is on safari.", "type": "example"}, {"content": "engenn5le08ob04aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use when you are in nature.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "in the heart of ", "type": "name"}, {"content": "in the middle of a place ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Sally is in the heart of Africa.", "type": "example"}, {"content": "engenn5le08ob04aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "buzzard ", "type": "name"}, {"content": "a large bird that eats animals that are dead ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There were buzzards flying overhead.", "type": "example"}, {"content": "engenn5le08ob04aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to fit ", "type": "name"}, {"content": "to belong in a particular situation, place, or group ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Through experience you realize where you fit in the world.", "type": "example"}, {"content": "engenn5le08ob04aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "insect ", "type": "name"}, {"content": "a small animal that has six legs  ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There were so many insects on our tour.", "type": "example"}, {"content": "engenn5le08ob04aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "cycle ", "type": "name"}, {"content": "a set of events or actions that happen again and again in the same order ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We are all part of the life cycle.", "type": "example"}, {"content": "engenn5le08ob04aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Read the table below aloud.", "type": "text"}, {"content": "Read the following phrases that use both the <span class=\"italic\">th</span> and <span class=\"italic\">d</span> sounds. <br/><ul><li>What does this do?</li> <li>Don't do that.</li> <li>My brother's dog</li> <li>Don't breathe</li> <li>Another day</li></ul>", "type": "text"}, {"content": "Write 3 sentences using 6 of the words in the table.", "type": "text"}, {"content": "Read the sentences aloud.", "type": "text"}, {"content": "{\"rows\":7,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Th</span> Sound\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">D</span> Sound\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Z</span> Sound\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"they\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"day\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"zone\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"their\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"dare\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"zebra\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"those\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"doze\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"zodiac\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"than\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Dan\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"zap\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"worthy\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"wordy\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"zoom\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"breathe\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"breed\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"zeal\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}], "type": "takeaway_extension"}, {"contents": [{"content": "I pronounce difficult sounds with a partner.", "type": "text"}, {"content": "I write 3 sentence that use these sounds.", "type": "text"}, {"content": "I read the sentences aloud.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn5le08ob04re2img01.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn5le08ob04re2img01.jpg", "time": "100", "id": 1, "text": "Hello from the heart of Africa. It's Sally's Suitcase."}, {"image": "engenn5le08ob04re2img02.jpg", "time": "5000", "id": 2, "text": "Another wonderful day in the bush! We saw zebras in the thick bush, buzzards flying overhead and elephants drinking at the water's edge. I'm learning so much about nature!"}, {"image": "engenn5le08ob04re2img03.jpg", "time": "16500", "id": 3, "text": "Patrick, our guide and driver, explains everything. His knowledge of the area and its inhabitants is pretty amazing. He shows us how every animal, bird, plant, and insect is beautiful in its own way, and how each is necessary. He is happy to answer any questions we might have.  Luckily, he speaks French, Spanish and English."}, {"image": "engenn5le08ob04re2img01.jpg", "time": "41500", "id": 4, "text": "I can see why it's important for us to look after our world. We're only one small part of this perfect cycle. It is through these experiences that you realize where you fit into the world. That's probably the most important lesson there is to learn here."}], "audiosrc": "engenn5le08ob04re2aud01", "coverimg": "engenn5le08ob04re2img01.jpg"}, "type": "slideshow"}], "id": 2}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": "I can pronounce the contrasting consonant sounds <span class=\"italic\">th</span>, <span class=\"italic\">d</span> and <span class=\"italic\">z</span>. ", "type": "Learning Outcomes"}, {"content": "I can talk about travel and things to do on a trip. ", "type": "Learning Outcomes"}, {"content": "I can identify key information in a short audio.", "type": "Learning Outcomes"}, {"content": "What are the big 5 animals of Africa?", "type": "Free Header Item"}, {"content": "Would you like to go on a safari? Why or why not?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": " Ask your partner:", "type": "free_header_text"}, {"content": "Pronunciation Spot: Sally takes a journey into the heart of Africa.", "type": "free_type_text_area"}], "questions": [], "type": "WLC", "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "_data": [{"contents": [{"content": "Sally is on a safari in Africa. Listen as she reads her blog to a <span class=\"tool-tip\" id=\"tip_1_0\">fellow</span> tourist.", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}], "type": "learning_skills"}, {"content": [{"content": "<span class=\"italic\">\"Fellow\"</span> means a person who is in the same group. ", "tip_id": 0, "type": "text"}], "type": "tips"}, {"contents": [{"content": "Instructions: Click on the play button to listen to the audio.", "type": "text"}], "type": "post_instructions"}], "questions": [{"_