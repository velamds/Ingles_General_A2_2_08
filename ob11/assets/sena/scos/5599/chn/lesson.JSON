": "text", "content": " if I have time."}], "selected": 0, "id": 1}]}, {"_data": [{"type": "question", "contents": [{"type": "text", "content": "If you visit Africa,"}]}, {"type": "objective", "content": "secondary_2"}], "id": 1, "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": " you'll have to take a helicopter tour over the dunes."}], "selected": 0, "id": 1}]}, {"_data": [{"type": "question", "contents": [{"type": "text", "content": "If I get the chance,"}]}, {"type": "objective", "content": "secondary_2"}], "id": 2, "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": "I'll definitely go on another safari."}], "selected": 0, "id": 1}]}, {"_data": [{"type": "question", "contents": [{"type": "text", "content": "Will you stay in a luxury tent"}]}, {"type": "objective", "content": "secondary_2"}], "id": 3, "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": "if we go on a hike?"}], "selected": 0, "id": 1}]}, {"_data": [{"type": "question", "contents": [{"type": "rec", "content": ""}]}, {"type": "objective", "content": "secondary_2"}], "id": 4, "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 1}]}], "stimuli_ids": [], "id": 11, "type": "MT1", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " \nSally is working on her blog entry about Africa but there's some confusion. Can you help?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 2"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">Move the condition or result up or down <span class=\"sena-icon sena-icon-vertical-drag\"></span> to complete each sentence.</span>\n<span class=\"bullet\">Record yourself saying the sentences aloud. </span> \n<span class=\"bullet\">Check your pronunciation with your instructor.</span>"}]}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le08ob11re2aud01", "coverimg": "engenn5le08ob11re2img01.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le08ob11re2img01.jpg"}, {"text": "There are many things to do in Africa! I got back from the Namibian safari yesterday. It was even better than the one I went on before. I snapped lots of photos! I'll add more photos, when I have the time.", "id": 1, "time": "100", "image": "engenn5le08ob11re2img01.jpg"}, {"text": "If you visit Africa, you'll have to take a helicopter tour over the Sossusvlei Dunes. They are as red as blood.", "id": 2, "time": "15000", "image": "engenn5le08ob11re2img01.jpg"}, {"text": "I went on a hike and stayed in a luxury tent. I felt like I was sleeping in the heart of Mother Nature. I saw many mammals at the nature reserve. I think leopards and jaguars look similar. It's easy to get them confused but jaguars have smaller spots than leopards. My favorite big cat is the cheetah. They're the fastest and most interesting!", "id": 3, "time": "23500", "image": "engenn5le08ob11re2img01.jpg"}, {"text": "This was the best trip ever! If I get the chance, I'll definitely come back.", "id": 4, "time": "49000", "image": "engenn5le08ob11re2img01.jpg"}]}}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Sally goes on a Safari"}, {"type": "unit_name", "content": "Ready to Go"}, {"type": "position", "content": 11}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 8}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe characteristics of different people and their jobs."}, {"type": "secondary_1", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_3", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_4", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_5", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_6", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_7", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_8", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The First Conditional "}, {"type": "describer", "content": "You can use the first conditional to talk about actions and situations in the future."}, {"type": "text", "content": "There are two parts to the sentence.  <br> One part is the <span class=\"strong\">condition</span>. The other part is the<span class=\"strong\"> result</span>."}, {"type": "text", "content": "Form: <br><span class=\"italic\">If + subject + Simple Present tense  + subject + will/won't</span> <br> You use a comma after the condition in this form. "}, {"type": "text", "content": "You can flip the two parts of the sentence so that the result comes first. It can be in interrogative form. "}, {"type": "text", "content": "Form: <br> <span class=\"italic\">Will/Won't + subject + if + subject + Simple Present tense ?</span> <br/><br/> You can also use the future time clauses <span class=\"italic\">when</span> and  <span class=\"italic\">after</span> in the condition."}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Condition\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Result\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">If you visit Africa,</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">you'll have to visit Namibia! </span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">After I visit Africa,</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'll come back home.</span> \\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Result\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Condition\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Will you come back</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">when you get the chance?</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Will you come visit</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">if you have time?</span> \\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Simple Past Tense"}, {"type": "describer", "content": "You use the Simple Past tense to talk about actions and events that are finished. "}, {"type": "text", "content": "Simple Past tense verbs can be <span class=\"italic\">regular</span> or <span class=\"italic\">irregular</span>."}, {"type": "text", "content": "Regular verbs end in -<span class=\"italic\">ed</span> or -<span class=\"italic\">ied</span>. "}, {"type": "text", "content": "Irregular verbs change in different ways."}, {"type": "table", "content": "{\"rows\":8,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Simple Past Tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to see\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"saw\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to stay\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"stayed\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to confuse\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"confused\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to think\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"thought\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"had\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to leave\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"left\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"to begin\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"began\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": "We saw lots of things on our trip."}, {"type": "example", "content": "We had lots of great meals!"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "safari "}, {"type": "definition", "content": "a trip to see wild animals, especially in Africa"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I would like to go on a safari."}, {"type": "audio", "content": "engenn5le08ob11aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about things you do on a trip. "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to snap a photo"}, {"type": "definition", "content": "to photograph something quickly"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I snapped a photo of the moment."}, {"type": "audio", "content": "engenn5le08ob11aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "helicopter tour"}, {"type": "definition", "content": "a trip around an area on a helicopter"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Today, we are going on a helicopter tour of Botswana. "}, {"type": "audio", "content": "engenn5le08ob11aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "dune"}, {"type": "definition", "content": "a hill made of sand "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We will visit the dunes on our tour."}, {"type": "audio", "content": "engenn5le08ob11aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "hike"}, {"type": "definition", "content": "a long walk in the mountains"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The safari includes a hike to the mountains."}, {"type": "audio", "content": "engenn5le08ob11aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "luxury tent"}, {"type": "definition", "content": "a large shelter that consists of a sheet of white canvas supported by poles and ropes"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Relax in your own luxury tent."}, {"type": "audio", "content": "engenn5le08ob11aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "mammal"}, {"type": "definition", "content": "a type of animal that drinks milk from its mother's body when it is young."}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Rhinos are mammals, like humans."}, {"type": "audio", "content": "engenn5le08ob11aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "nature reserve"}, {"type": "definition", "content": "an area of land where wild animals and plants are protected "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We can go to the nature reserve."}, {"type": "audio", "content": "engenn5le08ob11aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "leopard"}, {"type": "definition", "content": "a member of the cat family, with yellow fur and black spots."}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Leopards are slower than lions."}, {"type": "audio", "content": "engenn5le08ob11aud09"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cheetah"}, {"type": "definition", "content": "a member of the cat family, with long legs and black spots."}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The cheetah is the fastest animal in the world."}, {"type": "audio", "content": "engenn5le08ob11aud10"}]}, {"type": "background_image", "content": "engenn5le08ob11re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Go on the internet. "}, {"type": "text", "content": "Get information about the places you want to visit in Africa and things you want to do."}, {"type": "text", "content": "Write a paragraph (7-8 sentences) using this information. "}, {"type": "text", "content": "Start your paragraph with the sentence: <span class=\"italic\">If I have the chance, I will go/visit ...</span>"}, {"type": "text", "content": "Proofread your paragraph. Read it aloud to a partner."}, {"type": "text", "content": "Listen to their paragraph. Compare the things you want to do. Are they the same? Different?"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write 7-8 sentences."}, {"type": "text", "content": "I talk about travel and things to do on a trip."}, {"type": "text", "content": "I compare my paragraph with a  partner."}]}], "type": "sena"}